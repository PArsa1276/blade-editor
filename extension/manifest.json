{
  "manifest_version": 3,
  "name": "Blade Bridge",
  "version": "1.0.2",
  "description": "Lets the Blade Editor app on this computer make Google Flow clips in this Chrome, with your own login.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "bridge.js"
  },
  "action": {
    "default_title": "Blade Bridge: click to connect to Blade Editor"
  }
}